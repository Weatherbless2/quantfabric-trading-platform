# This file is a template only. Copy it to runtime/config/HistoryData.env,
# set the read-only ClickHouse credentials locally, and never commit that copy.
QF_HISTORY_BACKEND=clickhouse
QF_HISTORY_CLICKHOUSE_URL=http://172.16.20.10:8123
QF_HISTORY_CLICKHOUSE_DATABASE=tdxdata
QF_HISTORY_TABLE=stkprice_1min
QF_HISTORY_CLICKHOUSE_USERNAME=
QF_HISTORY_CLICKHOUSE_PASSWORD=

# These defaults match the previous TDX table convention. Confirm them with a
# read-only sample query and adjust only this local file if the server differs.
QF_HISTORY_MARKET_CODES=SSE=S,SZSE=S
QF_HISTORY_SYMBOL_TEMPLATE={exchange}:{symbol}
# 240 根日 K 需要约 57,840 条 A 股一分钟行情来聚合。
QF_HISTORY_MAX_RAW_BARS=100000
QF_HISTORY_STALE_CACHE_SECONDS=60
QF_HISTORY_AUTH_URL=http://127.0.0.1:18080
