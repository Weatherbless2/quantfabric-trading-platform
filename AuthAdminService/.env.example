# Production uses PostgreSQL and Keycloak; do not use development mode there.
QF_POSTGRES_PASSWORD=CHANGE_ME
QF_KEYCLOAK_ADMIN_USERNAME=CHANGE_ME
QF_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
QF_AUTH_MODE=oidc
QF_AUTH_DATABASE_URL=postgresql+psycopg://quantfabric_auth:CHANGE_ME@postgres:5432/quantfabric_auth
QF_AUTH_INTERNAL_KEY=GENERATE_A_LONG_RANDOM_VALUE
QF_AUTH_DEFAULT_DOMAIN=desk:cn_equity
QF_OIDC_ISSUER=http://keycloak:8080/realms/quantfabric
QF_OIDC_AUDIENCE=quantfabric-desktop
QF_AUTH_SESSION_TTL_SECONDS=900
